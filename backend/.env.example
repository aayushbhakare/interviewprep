# Django Backend Configuration
DEBUG=False
SECRET_KEY=generate-a-strong-random-50-character-secret-key-for-production
ALLOWED_HOSTS=api.yourdomain.com,yourdomain.com,127.0.0.1,localhost

# PostgreSQL Database Configuration
DB_NAME=interview_platform
DB_USER=interview_admin
DB_PASSWORD=your_secure_db_password
DB_HOST=127.0.0.1
DB_PORT=5432

# CORS & CSRF Security (Comma-separated URLs)
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://app.yourdomain.com,https://api.yourdomain.com

# Production SSL & Cookie Security (Defaults to True when DEBUG=False)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# JWT Token Lifetimes
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Email Settings (Production SMTP e.g. SendGrid, Amazon SES, or Gmail App Password)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your_smtp_api_key
DEFAULT_FROM_EMAIL=InterviewPrep <support@yourdomain.com>

# Gemini AI Service (Optional - ₹0 local deterministic engine active by default)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Frontend Public Configuration
VITE_API_BASE_URL=https://api.yourdomain.com/api/v1
